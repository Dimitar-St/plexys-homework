# Server-only settings. Never prefix credentials with VITE_.
CORTEZA_URL=http://localhost:18080
APP_ORIGIN=http://localhost:5173
PORT=3001
HOST=127.0.0.1

# Create a dedicated Authorization Code client in Corteza Admin.
# Redirect URI: http://localhost:5173/auth/callback
# Scopes: profile api
CORTEZA_CLIENT_ID=
CORTEZA_CLIENT_SECRET=

# Copy numeric IDs from your Compose builder URLs; keep them as strings.
CORTEZA_NAMESPACE_ID=
CORTEZA_TICKET_MODULE_ID=
# Optional: leave empty if you did not create the Customer module.
CORTEZA_CUSTOMER_MODULE_ID=
