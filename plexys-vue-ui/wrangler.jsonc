{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plexys-vue-corteza-ui",
  "compatibility_date": "2026-09-25",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "main": "worker/index.ts",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSIONS",
        "class_name": "CortezaSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "CortezaSession"
      ]
    }
  ],
  "keep_vars": true
}
